# Copie para ".env.local" (cp .env.example .env.local) e preencha. Nunca versione o .env.local.

# URL pública do site (em produção, o domínio com https://)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (Project Settings → API) ----
# A URL e a chave "publishable" (sb_publishable_...) podem ir para o navegador: o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A chave "secret" (sb_secret_...) ignora o RLS: use só no servidor (webhooks e jobs).
SUPABASE_SECRET_KEY=

# ---- IA ----
# Quem responde: gemini (padrão), groq, deepseek, openrouter, openai ou custom (com AI_BASE_URL).
# Trocar aqui e fazer Redeploy na Vercel; as outras chaves podem continuar salvas.
AI_PROVIDER=gemini
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Os outros provedores (formato da API da OpenAI). Groq: https://console.groq.com/keys
AI_API_KEY=
# Opcional no groq (openai/gpt-oss-120b) e no deepseek (deepseek-chat); obrigatório nos outros
AI_MODEL=
# Opcional: modelo da análise mensal (padrão: o mesmo de AI_MODEL)
AI_INSIGHTS_MODEL=
# Só para AI_PROVIDER=custom
AI_BASE_URL=

# ---- WhatsApp Cloud API (Meta) — um app da LumenzIA para todas as clínicas ----
# Senha inventada por você, a mesma cadastrada no webhook do app na Meta
WHATSAPP_VERIFY_TOKEN=
# App settings → Basic do app na Meta
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business → Configurations → configuração "WhatsApp Embedded Signup"
# (sem ela, o botão "Conectar WhatsApp" do painel fica indisponível)
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Instagram (o mesmo app da Meta, produto "Instagram" com login do Instagram) ----
# Instagram → API setup with Instagram login: o id e a chave do Instagram (diferentes do app)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Senha do webhook do Instagram (vazia = a mesma do WHATSAPP_VERIFY_TOKEN)
INSTAGRAM_VERIFY_TOKEN=
# Opcional: versão da API (vazia = a que a Meta usar por padrão)
INSTAGRAM_API_VERSION=

# ---- E-mails de avisos e lembretes (Resend) — https://resend.com/api-keys ----
# Sem estas duas, o canal de e-mail fica indisponível no painel e só o WhatsApp é usado.
RESEND_API_KEY=
# Endereço do domínio verificado no Resend; o nome é trocado pelo da clínica nos lembretes
NOTIFY_EMAIL_FROM="LumenzIA <avisos@lumenzia.com.br>"

# ---- Pagamento ----
# "mock" para testar sem cobrar; "mercadopago" para cobrança real (obrigatório em produção)
PAYMENT_MODE=mock
# Credenciais do Mercado Pago (Suas integrações → Credenciais de produção → Access Token)
MP_ACCESS_TOKEN=
# Webhooks → Configurar notificações: URL https://<seu-dominio>/api/webhooks/mercadopago, eventos
# "Planos e assinaturas". Cole aqui a "Assinatura secreta" mostrada lá.
MP_WEBHOOK_SECRET=

# ---- Jobs agendados ----
# O pg_cron chama as rotas /api/cron/* com esta senha. Ela é gerada pela migração 0007 e fica no
# Vault ("lumenzia_cron_secret"); copie o mesmo valor para cá e para a Vercel.
CRON_SECRET=
